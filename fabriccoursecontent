<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
  :root {
    --bg: #06090f;
    --card: #111a2e;
    --card-hover: #162038;
    --border: #1a2744;
    --border-light: #223050;
    --fg: #eaf0f9;
    --fg-muted: #7b8fad;
    --accent: #00d47b;
    --accent-dim: rgba(0,212,123,0.08);
    --accent-glow: rgba(0,212,123,0.2);
    --gold: #f5b731;
    --gold-dim: rgba(245,183,49,0.08);
    --fab-purple: #9b6dff;
    --fab-purple-dim: rgba(155,109,255,0.08);
    --fab-purple-glow: rgba(155,109,255,0.15);
    --fab-purple-soft: #b794f6;
    --fab-blue: #5b9bf5;
    --fab-blue-dim: rgba(91,155,245,0.08);
    --fab-teal: #3ecfb2;
    --fab-teal-dim: rgba(62,207,178,0.08);
    --fab-orange: #f59b42;
    --fab-orange-dim: rgba(245,155,66,0.08);
    --error: #ff4d6a;
    --radius: 14px;
    --radius-sm: 10px;
  }
  * { margin:0; padding:0; box-sizing:border-box; }
  html { scroll-behavior: smooth; }
  body {
    font-family:'DM Sans',sans-serif;
    background:var(--bg);
    color:var(--fg);
    min-height:100vh;
    overflow-x:hidden;
    line-height:1.6;
  }

  .atmo-grid {
    position:fixed;inset:0;z-index:0;pointer-events:none;
    background-image:
      linear-gradient(rgba(155,109,255,0.015) 1px,transparent 1px),
      linear-gradient(90deg,rgba(155,109,255,0.015) 1px,transparent 1px);
    background-size:80px 80px;
  }
  .atmo-glow { position:fixed;pointer-events:none;z-index:0;border-radius:50%; }
  .atmo-glow.g1 {
    width:600px;height:600px;top:-200px;right:-100px;
    background:radial-gradient(circle,rgba(155,109,255,0.07),transparent 70%);
    animation:drift 14s ease-in-out infinite;
  }
  .atmo-glow.g2 {
    width:500px;height:500px;bottom:-150px;left:-100px;
    background:radial-gradient(circle,rgba(91,155,245,0.05),transparent 70%);
    animation:drift 18s ease-in-out infinite reverse;
  }
  .atmo-glow.g3 {
    width:400px;height:400px;top:40%;left:50%;transform:translate(-50%,-50%);
    background:radial-gradient(circle,rgba(155,109,255,0.04),transparent 60%);
    animation:drift 22s ease-in-out infinite;
  }
  @keyframes drift {
    0%,100%{transform:translate(0,0) scale(1);}
    50%{transform:translate(20px,-15px) scale(1.05);}
  }

  .container { position:relative;z-index:1;max-width:960px;margin:0 auto;padding:0 24px; }

  .navbar {
    position:fixed;top:0;left:0;right:0;z-index:100;
    background:rgba(6,9,15,0.88);backdrop-filter:blur(20px);
    border-bottom:1px solid var(--border);
  }
  .navbar.scrolled { background:rgba(6,9,15,0.96); }
  .nav-inner {
    max-width:960px;margin:0 auto;padding:0 24px;
    display:flex;align-items:center;justify-content:space-between;height:68px;
  }
  .nav-logo {
    display:flex;align-items:center;gap:10px;
    text-decoration:none;color:var(--fg);
  }
  .nav-logo-icon {
    width:36px;height:36px;border-radius:9px;
    background:linear-gradient(135deg,var(--accent),#00a86b);
    display:flex;align-items:center;justify-content:center;
    font-size:16px;color:var(--bg);font-weight:700;
    font-family:'Space Grotesk',sans-serif;
  }
  .nav-logo-text {
    font-family:'Space Grotesk',sans-serif;
    font-size:18px;font-weight:700;letter-spacing:-0.5px;
  }
  .nav-right { display:flex;align-items:center;gap:10px; }
  .nav-link {
    padding:8px 16px;border:none;background:transparent;
    color:var(--fg-muted);font-family:'DM Sans',sans-serif;
    font-size:13px;font-weight:500;cursor:pointer;
    border-radius:8px;transition:all 0.25s;text-decoration:none;
  }
  .nav-link:hover { color:var(--fg);background:rgba(255,255,255,0.05); }
  .nav-cta {
    padding:8px 20px;border:none;border-radius:8px;
    background:var(--accent);color:var(--bg);
    font-family:'DM Sans',sans-serif;font-size:13px;
    font-weight:600;cursor:pointer;transition:all 0.25s;
    text-decoration:none;display:inline-flex;align-items:center;gap:7px;
  }
  .nav-cta:hover { box-shadow:0 0 20px var(--accent-glow);transform:translateY(-1px); }
  .mobile-toggle {
    display:none;background:none;border:none;
    color:var(--fg);font-size:20px;cursor:pointer;padding:8px;
  }

  .course-hero { padding:140px 0 48px;text-align:center; }
  .breadcrumb {
    display:inline-flex;align-items:center;gap:6px;
    font-size:13px;color:var(--fg-muted);margin-bottom:24px;
  }
  .breadcrumb a { color:var(--fg-muted);text-decoration:none;transition:color 0.25s; }
  .breadcrumb a:hover { color:var(--fab-purple); }
  .breadcrumb .sep { opacity:0.4; }

  .course-badge-row {
    display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin-bottom:24px;
  }
  .course-tag {
    display:inline-flex;align-items:center;gap:6px;
    padding:6px 16px;border-radius:50px;
    font-size:12px;font-weight:600;
    border:1px solid var(--border);background:rgba(255,255,255,0.03);color:var(--fg-muted);
  }
  .course-tag.ct-purple { border-color:rgba(155,109,255,0.3);color:var(--fab-purple);background:var(--fab-purple-dim); }
  .course-tag.ct-blue { border-color:rgba(91,155,245,0.3);color:var(--fab-blue);background:var(--fab-blue-dim); }
  .course-tag.ct-gold { border-color:rgba(245,183,49,0.3);color:var(--gold);background:var(--gold-dim); }
  .course-tag.ct-teal { border-color:rgba(62,207,178,0.3);color:var(--fab-teal);background:var(--fab-teal-dim); }

  .course-hero h1 {
    font-family:'Space Grotesk',sans-serif;
    font-size:clamp(32px,5.5vw,56px);
    font-weight:700;line-height:1.1;letter-spacing:-1.5px;margin-bottom:16px;
  }
  .course-hero h1 .hl { color:var(--fab-purple); }
  .ch-desc {
    font-size:17px;color:var(--fg-muted);max-width:640px;
    margin:0 auto 36px;line-height:1.7;
  }
  .hero-meta-bar {
    display:flex;justify-content:center;gap:0;
    background:var(--card);border:1px solid var(--border);
    border-radius:var(--radius-sm);overflow:hidden;
    max-width:640px;margin:0 auto;
  }
  .hero-meta-item {
    flex:1;padding:18px 16px;text-align:center;
    border-right:1px solid var(--border);
  }
  .hero-meta-item:last-child { border-right:none; }
  .hmi-val {
    font-family:'Space Grotesk',sans-serif;
    font-size:22px;font-weight:700;color:var(--fg);
  }
  .hmi-val.purple { color:var(--fab-purple); }
  .hmi-label {
    font-size:11px;color:var(--fg-muted);
    text-transform:uppercase;letter-spacing:0.8px;margin-top:2px;
  }

  /* Fabric experience badges below hero */
  .fabric-exp-bar {
    display:flex;justify-content:center;gap:10px;flex-wrap:wrap;
    max-width:680px;margin:28px auto 0;
  }
  .fab-exp-item {
    display:flex;align-items:center;gap:7px;
    padding:8px 14px;border-radius:8px;
    background:var(--card);border:1px solid var(--border);
    font-size:12px;font-weight:500;color:var(--fg-muted);
    transition:all 0.25s;
  }
  .fab-exp-item:hover { border-color:rgba(155,109,255,0.3); }
  .fab-exp-item i { font-size:14px; }
  .fab-exp-item.fe-data-factory i { color:var(--fab-purple); }
  .fab-exp-item.fe-lakehouse i { color:var(--fab-blue); }
  .fab-exp-item.fe-warehouse i { color:var(--fab-teal); }
  .fab-exp-item.fe-realtime i { color:var(--fab-orange); }
  .fab-exp-item.fe-powerbi i { color:var(--gold); }
  .fab-exp-item.fe-onelake i { color:var(--fab-purple-soft); }

  .progress-section { padding:32px 0 24px; }
  .progress-track-wrap {
    background:var(--card);border:1px solid var(--border);
    border-radius:var(--radius);padding:28px 28px 20px;
  }
  .progress-header {
    display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;
  }
  .progress-title {
    font-family:'Space Grotesk',sans-serif;font-size:15px;font-weight:600;
  }
  .progress-count {
    font-size:13px;color:var(--fg-muted);font-family:'Space Grotesk',monospace;
  }
  .progress-count span { color:var(--fab-purple);font-weight:600; }
  .progress-dots { display:flex;gap:5px;align-items:center; }
  .p-dot {
    flex:1;height:6px;border-radius:3px;background:var(--border);
    cursor:pointer;transition:all 0.3s;
  }
  .p-dot:hover { background:var(--border-light); }
  .p-dot.active { background:var(--fab-purple); }
  .p-dot.visited { background:rgba(155,109,255,0.3); }

  .phase-divider {
    display:flex;align-items:center;gap:14px;
    margin:32px 0 18px;padding:0 4px;
  }
  .phase-divider .pd-line { flex:1;height:1px;background:var(--border); }
  .phase-divider .pd-label {
    font-size:11px;font-weight:700;text-transform:uppercase;
    letter-spacing:2px;color:var(--fab-purple);white-space:nowrap;
  }
  .phase-divider .pd-icon {
    width:28px;height:28px;border-radius:7px;
    background:var(--fab-purple-dim);
    display:flex;align-items:center;justify-content:center;
    font-size:12px;color:var(--fab-purple);
  }

  .days-section { padding:16px 0 40px; }
  .day-card {
    background:var(--card);border:1px solid var(--border);
    border-radius:var(--radius);margin-bottom:12px;
    overflow:hidden;transition:border-color 0.3s;
  }
  .day-card:hover { border-color:var(--border-light); }
  .day-card.active { border-color:rgba(155,109,255,0.35); }

  .day-header {
    width:100%;padding:20px 26px;background:transparent;
    border:none;color:var(--fg);font-family:'DM Sans',sans-serif;
    font-size:15px;font-weight:500;text-align:left;
    cursor:pointer;display:flex;align-items:center;gap:14px;
    transition:background 0.25s;
  }
  .day-header:hover { background:rgba(255,255,255,0.015); }

  .day-num {
    flex-shrink:0;width:42px;height:42px;border-radius:11px;
    background:var(--fab-purple-dim);
    display:flex;align-items:center;justify-content:center;
    font-family:'Space Grotesk',sans-serif;
    font-size:13px;font-weight:700;color:var(--fab-purple);
    transition:all 0.3s;
  }
  .day-card.active .day-num { background:var(--fab-purple);color:#fff; }

  .day-info { flex:1;min-width:0; }
  .day-info h3 {
    font-family:'Space Grotesk',sans-serif;
    font-size:15px;font-weight:600;margin-bottom:1px;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  }
  .day-info .day-sub { font-size:12px;color:var(--fg-muted); }

  .day-topics-count {
    flex-shrink:0;padding:4px 11px;border-radius:50px;
    background:rgba(255,255,255,0.04);
    font-size:11px;color:var(--fg-muted);
    font-family:'Space Grotesk',monospace;
  }

  .day-chevron {
    flex-shrink:0;font-size:13px;color:var(--fg-muted);
    transition:transform 0.35s,color 0.3s;
  }
  .day-card.active .day-chevron { transform:rotate(180deg);color:var(--fab-purple); }

  .day-body {
    max-height:0;overflow:hidden;
    transition:max-height 0.5s cubic-bezier(0.22,1,0.36,1);
  }
  .day-card.active .day-body { max-height:1000px; }
  .day-body-inner { padding:0 26px 22px; }

  .topic-subcat {
    display:flex;align-items:center;gap:8px;
    margin:14px 0 6px;padding-top:12px;
    border-top:1px solid rgba(255,255,255,0.04);
  }
  .topic-subcat:first-child { margin-top:0;padding-top:0;border-top:none; }
  .topic-subcat .ts-dot {
    width:6px;height:6px;border-radius:50%;
    background:var(--fab-purple);flex-shrink:0;
  }
  .topic-subcat .ts-label {
    font-size:11px;font-weight:700;text-transform:uppercase;
    letter-spacing:1.5px;color:var(--fab-purple-soft);
  }

  .topic-list { list-style:none; }
  .topic-list li {
    display:flex;align-items:flex-start;gap:11px;
    padding:7px 0;border-bottom:1px solid rgba(255,255,255,0.02);
    font-size:13.5px;color:var(--fg);line-height:1.5;
  }
  .topic-list li:last-child { border-bottom:none; }
  .topic-check {
    flex-shrink:0;width:20px;height:20px;border-radius:5px;
    background:var(--fab-purple-dim);
    display:flex;align-items:center;justify-content:center;margin-top:2px;
  }
  .topic-check i { font-size:9px;color:var(--fab-purple);opacity:0.5; }

  .day-tags {
    display:flex;gap:7px;flex-wrap:wrap;
    margin-top:14px;padding-top:12px;border-top:1px solid var(--border);
  }
  .day-tag {
    padding:3px 10px;border-radius:50px;
    font-size:10px;font-weight:600;
    background:rgba(255,255,255,0.035);color:var(--fg-muted);
    border:1px solid rgba(255,255,255,0.05);
  }

  .projects-section { padding:40px 0; }
  .projects-box {
    background:linear-gradient(135deg,var(--fab-purple-dim),rgba(91,155,245,0.03));
    border:1px solid rgba(155,109,255,0.18);
    border-radius:var(--radius);padding:40px 36px;text-align:center;
  }
  .pb-icon {
    width:64px;height:64px;margin:0 auto 20px;border-radius:16px;
    background:var(--fab-purple-dim);
    display:flex;align-items:center;justify-content:center;
    font-size:28px;color:var(--fab-purple);
  }
  .projects-box h2 {
    font-family:'Space Grotesk',sans-serif;
    font-size:28px;font-weight:700;letter-spacing:-0.5px;margin-bottom:12px;
  }
  .projects-box p {
    font-size:15px;color:var(--fg-muted);max-width:520px;
    margin:0 auto 24px;line-height:1.7;
  }
  .project-highlights {
    display:grid;grid-template-columns:repeat(4,1fr);gap:12px;
    max-width:620px;margin:0 auto 28px;
  }
  .ph-item {
    background:rgba(0,0,0,0.2);border:1px solid rgba(255,255,255,0.05);
    border-radius:var(--radius-sm);padding:14px 10px;text-align:center;
  }
  .ph-item i { font-size:18px;color:var(--fab-purple);margin-bottom:6px;display:block; }
  .ph-item span { font-size:11px;color:var(--fg-muted);font-weight:500; }

  .outcomes-section { padding:40px 0; }
  .outcomes-grid { display:grid;grid-template-columns:repeat(2,1fr);gap:14px; }
  .outcome-card {
    background:var(--card);border:1px solid var(--border);
    border-radius:var(--radius-sm);padding:20px 18px;
    display:flex;gap:14px;align-items:flex-start;transition:all 0.3s;
  }
  .outcome-card:hover { border-color:rgba(155,109,255,0.3);transform:translateY(-2px); }
  .outcome-icon {
    flex-shrink:0;width:38px;height:38px;border-radius:9px;
    background:var(--fab-purple-dim);
    display:flex;align-items:center;justify-content:center;
    font-size:15px;color:var(--fab-purple);
  }
  .outcome-card h4 {
    font-family:'Space Grotesk',sans-serif;
    font-size:14px;font-weight:600;margin-bottom:3px;
  }
  .outcome-card p { font-size:12px;color:var(--fg-muted);line-height:1.5; }

  .cta-section { padding:40px 0 80px; }
  .cta-box {
    background:linear-gradient(135deg,rgba(155,109,255,0.08),rgba(91,155,245,0.02));
    border:1px solid rgba(155,109,255,0.2);
    border-radius:var(--radius);padding:52px 36px;
    text-align:center;position:relative;overflow:hidden;
  }
  .cta-box::before {
    content:'';position:absolute;top:-50%;left:-50%;
    width:200%;height:200%;
    background:radial-gradient(circle at 30% 40%,rgba(155,109,255,0.05),transparent 50%);
    pointer-events:none;
  }
  .cta-box h2 {
    font-family:'Space Grotesk',sans-serif;
    font-size:clamp(22px,3.5vw,32px);font-weight:700;
    letter-spacing:-0.8px;margin-bottom:12px;position:relative;
  }
  .cta-box p {
    font-size:15px;color:var(--fg-muted);max-width:500px;
    margin:0 auto 28px;line-height:1.7;position:relative;
  }
  .cta-actions {
    display:flex;gap:14px;justify-content:center;
    flex-wrap:wrap;position:relative;
  }
  .btn {
    padding:13px 30px;border:none;border-radius:var(--radius-sm);
    font-family:'DM Sans',sans-serif;font-size:14px;
    font-weight:600;cursor:pointer;transition:all 0.3s;
    display:inline-flex;align-items:center;gap:9px;text-decoration:none;
  }
  .btn-primary { background:var(--accent);color:var(--bg); }
  .btn-primary:hover { box-shadow:0 0 28px var(--accent-glow);transform:translateY(-2px); }
  .btn-whatsapp { background:#25d366;color:#fff; }
  .btn-whatsapp:hover { box-shadow:0 0 28px rgba(37,211,102,0.3);transform:translateY(-2px); }
  .btn-outline { background:transparent;color:var(--fg);border:1px solid var(--border); }
  .btn-outline:hover { border-color:var(--fab-purple);color:var(--fab-purple); }

  footer { border-top:1px solid var(--border);padding:32px 0; }
  .footer-inner {
    display:flex;justify-content:space-between;align-items:center;
    flex-wrap:wrap;gap:12px;font-size:12px;color:var(--fg-muted);
  }
  .footer-contact { display:flex;gap:16px;flex-wrap:wrap; }
  .footer-contact a {
    color:var(--fg-muted);text-decoration:none;
    display:flex;align-items:center;gap:5px;transition:color 0.25s;
  }
  .footer-contact a:hover { color:var(--fab-purple); }

  .whatsapp-float {
    position:fixed;bottom:24px;right:24px;z-index:200;
    width:56px;height:56px;border-radius:50%;background:#25d366;
    display:flex;align-items:center;justify-content:center;
    font-size:26px;color:#fff;cursor:pointer;
    box-shadow:0 4px 24px rgba(37,211,102,0.35);
    transition:all 0.3s;text-decoration:none;
    animation:waFloat 3s ease-in-out infinite;
  }
  .whatsapp-float:hover {
    transform:scale(1.1);box-shadow:0 6px 32px rgba(37,211,102,0.5);animation:none;
  }
  @keyframes waFloat {
    0%,100%{transform:translateY(0);}
    50%{transform:translateY(-8px);}
  }
  .wa-tooltip {
    position:absolute;right:68px;top:50%;transform:translateY(-50%);
    white-space:nowrap;background:var(--card);border:1px solid var(--border);
    padding:7px 14px;border-radius:8px;font-size:12px;font-weight:500;
