  /* ══════════════════════════════
     Render Session Cards
     ══════════════════════════════ */
  var daysContainer = document.getElementById("daysContainer");
  var cardsHtml = "";

  for (var pi = 0; pi < phases.length; pi++) {
    var phase = phases[pi];

    cardsHtml += '<div class="phase-divider">'
      + '<span class="pd-line"></span>'
      + '<span class="pd-icon"><i class="fas ' + phase.icon + '"></i></span>'
      + '<span class="pd-label">Phase ' + (pi + 1) + ': ' + phase.name + '</span>'
      + '<span class="pd-line"></span>'
      + '</div>';

    for (var ci = 0; ci < phase.classes.length; ci++) {
      var cls = phase.classes[ci];
      var topicCount = 0;
      if (cls.subcategories) {
        for (var sc = 0; sc < cls.subcategories.length; sc++) {
          topicCount += cls.subcategories[sc].topics.length;
        }
      }

      var topicsHtml = "";
      if (cls.subcategories) {
        for (var si = 0; si < cls.subcategories.length; si++) {
          var subcat = cls.subcategories[si];
          topicsHtml += '<div class="topic-subcat">'
            + '<span class="ts-dot"></span>'
            + '<span class="ts-label">' + subcat.label + '</span>'
            + '</div>'
            + '<ul class="topic-list">';
          for (var ti = 0; ti < subcat.topics.length; ti++) {
            topicsHtml += '<li>'
              + '<span class="topic-check"><i class="fas fa-check"></i></span>'
              + '<span>' + subcat.topics[ti] + '</span>'
              + '</li>';
          }
          topicsHtml += '</ul>';
        }
      }

      var tagsSpan = "";
      if (cls.tags) {
        for (var g = 0; g < cls.tags.length; g++) {
          tagsSpan += '<span class="day-tag">' + cls.tags[g] + '</span>';
        }
      }

      cardsHtml += '<div class="day-card" data-day="' + cls.day + '">'
        + '<button class="day-header" aria-expanded="false">'
        + '<span class="day-num">S' + cls.day + '</span>'
        + '<div class="day-info">'
        + '<h3>Session ' + cls.day + ': ' + cls.title + '</h3>'
        + '<span class="day-sub">' + cls.subtitle + '</span>'
        + '</div>'
        + '<span class="day-topics-count">' + topicCount + ' topics</span>'
        + '<span class="day-chevron"><i class="fas fa-chevron-down"></i></span>'
        + '</button>'
        + '<div class="day-body">'
        + '<div class="day-body-inner">'
        + topicsHtml
        + '<div class="day-tags">' + tagsSpan + '</div>'
        + '</div>'
        + '</div>'
        + '</div>';
    }
  }
  daysContainer.innerHTML = cardsHtml;

  /* ══════════════════════════════
     Accordion Logic
     ══════════════════════════════ */
  var dayCards = document.querySelectorAll(".day-card");
  var activeDay = null;

  function openDay(card) {
    if (activeDay && activeDay !== card) {
      activeDay.classList.remove("active");
      activeDay.querySelector(".day-header").setAttribute("aria-expanded", "false");
    }
    card.classList.add("active");
    card.querySelector(".day-header").setAttribute("aria-expanded", "true");
    activeDay = card;
    updateDots();
  }

  function closeDay(card) {
    card.classList.remove("active");
    card.querySelector(".day-header").setAttribute("aria-expanded", "false");
    activeDay = null;
    updateDots();
  }

  for (var c = 0; c < dayCards.length; c++) {
    (function(card) {
      card.querySelector(".day-header").addEventListener("click", function() {
        if (card.classList.contains("active")) closeDay(card);
        else openDay(card);
      });
    })(dayCards[c]);
  }

  /* ══════════════════════════════
     Progress Dots
     ══════════════════════════════ */
  var pDots = document.querySelectorAll(".p-dot");

  for (var p = 0; p < pDots.length; p++) {
    (function(dot) {
      dot.addEventListener("click", function() {
        var dayNum = parseInt(dot.getAttribute("data-day"));
        var targetCard = document.querySelector('.day-card[data-day="' + dayNum + '"]');
        if (targetCard) {
          openDay(targetCard);
          var offset = document.getElementById("navbar").offsetHeight + 16;
          var top = targetCard.getBoundingClientRect().top + window.pageYOffset - offset;
          window.scrollTo({ top: top, behavior: "smooth" });
        }
      });
    })(pDots[p]);
  }

  function updateDots() {
    for (var u = 0; u < pDots.length; u++) pDots[u].classList.remove("active");
    if (activeDay) {
      var activeDayNum = parseInt(activeDay.getAttribute("data-day"));
      var activeDot = document.querySelector('.p-dot[data-day="' + activeDayNum + '"]');
      if (activeDot) activeDot.classList.add("active");
    }
  }

  /* ══════════════════════════════
     Scroll: Track visited dots
     ════════════════════════════ */
  if ("IntersectionObserver" in window) {
    var dayObserver = new IntersectionObserver(function(entries) {
      for (var e = 0; e < entries.length; e++) {
        if (entries[e].isIntersecting) {
          var card = entries[e].target;
          var dayNum = parseInt(card.getAttribute("data-day"));
          for (var u = 0; u < pDots.length; u++) pDots[u].classList.remove("visited");
          for (var v = 0; v < dayNum - 1; v++) {
            var vd = document.querySelector('.p-dot[data-day="' + (v + 1) + '"]');
            if (vd) vd.classList.add("visited");
          }
        }
      }
    }, { threshold: 0.3, rootMargin: "-80px 0px -60% 0px" });

    for (var o = 0; o < dayCards.length; o++) dayObserver.observe(dayCards[o]);
  }

  /* ══════════════════════════════
     Scroll Reveal
     ══════════════════════════════ */
  var revealEls = document.querySelectorAll(
    ".day-card, .outcome-card, .projects-box, .cta-box, .progress-track-wrap, .phase-divider, .fab-exp-item"
  );
  if ("IntersectionObserver" in window) {
    var revealObs = new IntersectionObserver(function(entries) {
      for (var r = 0; r < entries.length; r++) {
        if (entries[r].isIntersecting) {
          entries[r].target.style.opacity = "1";
          entries[r].target.style.transform = "translateY(0)";
          revealObs.unobserve(entries[r].target);
        }
      }
    }, { threshold: 0.06, rootMargin: "0px 0px -20px 0px" });

    for (var rv = 0; rv < revealEls.length; rv++) {
      revealEls[rv].style.opacity = "0";
      revealEls[rv].style.transform = "translateY(20px)";
      revealEls[rv].style.transition = "opacity 0.5s ease, transform 0.5s ease";
      revealObs.observe(revealEls[rv]);
    }
  }

  /* ══════════════════════════════
     Navbar scroll
     ══════════════════════════════ */
  var navbar = document.getElementById("navbar");
  window.addEventListener("scroll", function() {
    navbar.classList.toggle("scrolled", window.scrollY > 30);
  }, { passive: true });

  /* ══════════════════════════════
     Auto-open Session 1
     ══════════════════════════════ */
  setTimeout(function() {
    var firstCard = document.querySelector('.day-card[data-day="1"]');
    if (firstCard) openDay(firstCard);
  }, 600);

})();
</script>
</body>
</html>